#version 460

// True 2D GPU Navier-Stokes Ground-Fog Solver — Stage 3:
// - Mark Harris (GPU Gems Ch. 38, 2004) Jacobi Pressure Poisson Solver: nabla^2 p = div(u).
// Runs 12 ultra-fast L2-cached ping-pong iterations (~0.07 ms total on 256x256 RG16F!).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rg16f) uniform writeonly image2D u_press_out;
layout(set = 0, binding = 1) uniform sampler2D u_press_in;

const int kN = 256;

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= kN || gid.y >= kN) return;

    ivec2 cL = clamp(gid + ivec2(-1, 0), ivec2(0), ivec2(kN - 1));
    ivec2 cR = clamp(gid + ivec2( 1, 0), ivec2(0), ivec2(kN - 1));
    ivec2 cD = clamp(gid + ivec2( 0,-1), ivec2(0), ivec2(kN - 1));
    ivec2 cU = clamp(gid + ivec2( 0, 1), ivec2(0), ivec2(kN - 1));

    float pL = texelFetch(u_press_in, cL, 0).r;
    float pR = texelFetch(u_press_in, cR, 0).r;
    float pD = texelFetch(u_press_in, cD, 0).r;
    float pU = texelFetch(u_press_in, cU, 0).r;
    float div = texelFetch(u_press_in, gid, 0).g;

    float p_new = 0.25 * (pL + pR + pD + pU - div);
    imageStore(u_press_out, gid, vec4(p_new, div, 0.0, 0.0));
}
