#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Quarter-resolution selective emissive bloom extract + 13-tap Kawase blur.
// Only high-luminance emissives (campfires, fireballs, lightning, magma, snow highlights) glow.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1) uniform sampler u_samplers[];
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D u_bloom_out;

struct LightingParams {
    vec4 proj_info;
    vec4 vz_and_size;
    vec4 sun_dir_view;
    vec4 sun_screen;
    vec4 shadow_tint;
    vec4 fog_color;
    vec4 scatter_color;
    vec4 bloom_rim;     // x = bloom_threshold, y = bloom_strength, z = rim_strength, w = key_strength
    vec4 world_up_view; // xyz = normalized world-up in view space, w = ssgi_strength
    vec4 ground_bounce; // rgb = biome ground/magma bounce tint, a = hemi_strength
    vec4 spec_contact;  // x = spec_strength, y = spec_gloss, z = contact_shadow_str, w = vibrance
    uvec4 tex_slots;    // x = color_slot, y = depth_slot, z = gtao_slot, w = vol_slot
    uvec4 aux_slots;    // x = bloom_slot, y = linear_sampler, z = out_w, w = out_h
    uvec4 ext_slots;    // x = ssgi_slot, y = gtao_raw_slot, z = biome_id, w = flags
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightingParamsBuf {
    LightingParams p;
};

layout(push_constant) uniform LightingPush {
    LightingParamsBuf buf;
} pc;

vec3 soft_threshold(vec3 c, float thresh) {
    float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    // Chromatic emissive boost: fire, torches, lava, fireballs, lightning, and sparks have high saturation
    // and bloom richly, while neutral white snow stays clean and un-washed-out!
    float cmax = max(c.r, max(c.g, c.b));
    float cmin = min(c.r, min(c.g, c.b));
    float sat = (cmax - cmin) / max(cmax, 1e-4);
    float eff_luma = luma * (0.82 + 0.55 * sat);

    float knee = 0.24;
    float soft = clamp(eff_luma - thresh + knee, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee + 1e-5);
    float contrib = max(eff_luma - thresh, soft) / max(eff_luma, 1e-4);
    return c * (contrib * (0.75 + 0.85 * sat));
}

// Karis luminance weight suppresses single-pixel firefly aliasing on tiny torch flames & sparks.
float karis_weight(vec3 c) {
    return 1.0 / (1.0 + dot(c, vec3(0.2126, 0.7152, 0.0722)));
}

vec3 sample_scene(LightingParams p, vec2 uv) {
    return texture(sampler2D(u_textures[nonuniformEXT(p.tex_slots.x)],
                             u_samplers[nonuniformEXT(p.aux_slots.y)]),
                   clamp(uv, vec2(0.001), vec2(0.999))).rgb;
}

void main() {
    LightingParams p = pc.buf.p;
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= int(p.aux_slots.z) || gid.y >= int(p.aux_slots.w)) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(p.aux_slots.zw);
    vec2 tx = 2.0 / p.vz_and_size.zw;
    float th = p.bloom_rim.x;

    // 13-tap Karis-averaged downsample (anti-flicker on small torches, embers, and hit sparks).
    vec3 c0 = soft_threshold(sample_scene(p, uv), th);
    vec3 c1 = soft_threshold(sample_scene(p, uv + vec2(-tx.x, -tx.y)), th);
    vec3 c2 = soft_threshold(sample_scene(p, uv + vec2( tx.x, -tx.y)), th);
    vec3 c3 = soft_threshold(sample_scene(p, uv + vec2(-tx.x,  tx.y)), th);
    vec3 c4 = soft_threshold(sample_scene(p, uv + vec2( tx.x,  tx.y)), th);

    vec3 e1 = soft_threshold(sample_scene(p, uv + vec2(-2.0 * tx.x, 0.0)), th);
    vec3 e2 = soft_threshold(sample_scene(p, uv + vec2( 2.0 * tx.x, 0.0)), th);
    vec3 e3 = soft_threshold(sample_scene(p, uv + vec2(0.0, -2.0 * tx.y)), th);
    vec3 e4 = soft_threshold(sample_scene(p, uv + vec2(0.0,  2.0 * tx.y)), th);

    vec3 d1 = soft_threshold(sample_scene(p, uv + vec2(-2.0 * tx.x, -2.0 * tx.y)), th);
    vec3 d2 = soft_threshold(sample_scene(p, uv + vec2( 2.0 * tx.x, -2.0 * tx.y)), th);
    vec3 d3 = soft_threshold(sample_scene(p, uv + vec2(-2.0 * tx.x,  2.0 * tx.y)), th);
    vec3 d4 = soft_threshold(sample_scene(p, uv + vec2( 2.0 * tx.x,  2.0 * tx.y)), th);

    vec3 g0 = (c1 + c2 + c3 + c4) * 0.25;
    vec3 g1 = (d1 + e3 + e1 + c0) * 0.25;
    vec3 g2 = (e3 + d2 + c0 + e2) * 0.25;
    vec3 g3 = (e1 + c0 + d3 + e4) * 0.25;
    vec3 g4 = (c0 + e2 + e4 + d4) * 0.25;

    float w0 = karis_weight(g0) * 0.50;
    float w1 = karis_weight(g1) * 0.125;
    float w2 = karis_weight(g2) * 0.125;
    float w3 = karis_weight(g3) * 0.125;
    float w4 = karis_weight(g4) * 0.125;
    vec3 sum = (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / max(w0 + w1 + w2 + w3 + w4, 1e-4);

    imageStore(u_bloom_out, gid, vec4(sum, 1.0));
}
