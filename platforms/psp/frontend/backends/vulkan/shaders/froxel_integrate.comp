#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Frostbite / Wronski True 3D Froxel Volumetric Fog — Pass 2: Closed-Form Analytical Z-Integration.
// Marches z = 0..63 along each of the 160x90 froxel columns in registers (~0.04 ms on 890M),
// outputting (accumulated_in_scatter.rgb, transmittance) to a 160x90x64 RGBA16F 3D texture for
// single-tap full-resolution hardware trilinear lookup in lighting_composite.comp!

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D u_integ_out;
layout(set = 1, binding = 1) uniform sampler3D u_scatter_cur;

struct FroxelIntegrateParams {
    vec4 slice_info; // x = near_z, y = far_z, z = 0, w = 0
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer FroxelIntegBuf {
    FroxelIntegrateParams p;
};

layout(push_constant) uniform FroxelIntegPush {
    FroxelIntegBuf buf;
} pc;

const int kFroxelW = 160;
const int kFroxelH = 90;
const int kFroxelD = 64;

float slice_depth(float s, float near_z, float far_z) {
    return near_z * pow(far_z / near_z, s / float(kFroxelD));
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= kFroxelW || gid.y >= kFroxelH) return;

    float near_z = pc.buf.p.slice_info.x;
    float far_z  = pc.buf.p.slice_info.y;

    vec3 accum_rgb = vec3(0.0);
    float accum_trans = 1.0;

    for (int z = 0; z < kFroxelD; ++z) {
        float z0 = slice_depth(float(z), near_z, far_z);
        float z1 = slice_depth(float(z + 1), near_z, far_z);
        float dz = max(z1 - z0, 1.0);

        vec4 s = texelFetch(u_scatter_cur, ivec3(gid.x, gid.y, z), 0);
        vec3 in_scatter = max(s.rgb, vec3(0.0));
        float sigma_t = max(s.a, 1e-6);

        // Frostbite closed-form analytical slice integration (energy-conserving at any optical depth!).
        float slice_t = exp(-sigma_t * dz);
        vec3 slice_scatter = (in_scatter - in_scatter * slice_t) / sigma_t;
        accum_rgb += accum_trans * slice_scatter;
        accum_trans *= slice_t;

        imageStore(u_integ_out, ivec3(gid.x, gid.y, z), vec4(min(accum_rgb, vec3(1.5)), clamp(accum_trans, 0.08, 1.0)));
    }
}
