#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Quarter-resolution Screen-Space Indirect Bounce (SSGI-lite):
// Gathers colored light from nearby bright/emissive surfaces (campfires, lava pools, Rathalos fireballs,
// Khezu lightning, sunlit snow/sand) and bounces it onto adjacent hunters, monsters, and cave walls.
// Runs in parallel with GTAO, Volumetric Fog, and Bloom with zero extra inter-pass barriers.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1) uniform sampler u_samplers[];
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D u_ssgi_out;

struct LightingParams {
    vec4 proj_info;
    vec4 vz_and_size;
    vec4 sun_dir_view;
    vec4 sun_screen;
    vec4 shadow_tint;
    vec4 fog_color;
    vec4 scatter_color;
    vec4 bloom_rim;
    vec4 world_up_view; // xyz = world-up in view space, w = ssgi_strength
    vec4 ground_bounce;
    vec4 spec_contact;
    uvec4 tex_slots;    // x = color_slot, y = depth_slot, z = gtao_slot, w = vol_slot
    uvec4 aux_slots;    // x = bloom_slot, y = linear_sampler, z = out_w, w = out_h
    uvec4 ext_slots;    // x = ssgi_slot, y = gtao_raw_slot, z = biome_id, w = flags
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightingParamsBuf {
    LightingParams p;
};

layout(push_constant) uniform LightingPush {
    LightingParamsBuf buf;
} pc;

float ign(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float linear_eye_z(LightingParams p, float d) {
    float zn = (d * 65535.0 - p.vz_and_size.y) / max(abs(p.vz_and_size.x), 1e-3);
    float denom = zn + p.proj_info.z;
    if (abs(denom) < 1e-5) denom = (denom >= 0.0 ? 1e-5 : -1e-5);
    return clamp(abs(p.proj_info.w / denom), 0.1, 20000.0);
}

void main() {
    LightingParams p = pc.buf.p;
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= int(p.aux_slots.z) || gid.y >= int(p.aux_slots.w)) return;

    if (p.world_up_view.w <= 0.001) {
        imageStore(u_ssgi_out, gid, vec4(0.0));
        return;
    }

    ivec2 full_max = ivec2(p.vz_and_size.zw) - ivec2(1);
    ivec2 ip = clamp(gid * 4 + ivec2(2), ivec2(0), full_max);
    uint dslot = p.tex_slots.y;
    uint cslot = p.tex_slots.x;
    uint lsamp = p.aux_slots.y;

    float d0 = texelFetch(u_textures[nonuniformEXT(dslot)], ip, 0).r;
    if (d0 >= 0.99992 || d0 <= 0.00001) {
        imageStore(u_ssgi_out, gid, vec4(0.0));
        return;
    }

    float z0 = linear_eye_z(p, d0);
    vec2 uv0 = (vec2(ip) + 0.5) / p.vz_and_size.zw;

    // Static spatial 8-tap golden-spiral bounce gather (NO frame-index rotation -> zero fire/torch flicker!).
    // Paired with quarter-res glow_blur.comp for silky-smooth indirect firelight & lava bounce.
    float noise = ign(vec2(gid));
    float base_ang = noise * 6.2831853;
    float max_rad = clamp(0.072 * (20.0 / max(z0 * 0.08, 1.0)), 0.020, 0.090);

    vec3 bounce_sum = vec3(0.0);
    float w_sum = 0.0;
    const int kTaps = 8;
    for (int i = 0; i < kTaps; ++i) {
        float ang = base_ang + float(i) * 0.78539816; // 45 deg
        float rad = max_rad * (0.28 + 0.72 * (float(i & 3) + 0.5) * 0.25);
        vec2 suv = clamp(uv0 + vec2(cos(ang), sin(ang) * 1.77) * rad, vec2(0.002), vec2(0.998));
        ivec2 sip = clamp(ivec2(suv * p.vz_and_size.zw), ivec2(0), full_max);
        float sd = texelFetch(u_textures[nonuniformEXT(dslot)], sip, 0).r;
        if (sd >= 0.99992 || sd <= 0.00001) continue;

        float zs = linear_eye_z(p, sd);
        // Only bounce light between surfaces that are actually close in 3D space (prevents sky/distant bleed).
        float z_diff = abs(zs - z0) / max(z0, 4.0);
        float depth_w = exp(-z_diff * 4.2);
        if (depth_w < 0.03) continue;

        vec3 sc = texture(sampler2D(u_textures[nonuniformEXT(cslot)],
                                    u_samplers[nonuniformEXT(lsamp)]), suv).rgb;
        float luma = dot(sc, vec3(0.2126, 0.7152, 0.0722));
        // Strongly favor saturated emissive sources (fireplaces, torches, lava, fireballs, lightning)
        // while keeping matte white snow clean.
        float cmax = max(sc.r, max(sc.g, sc.b));
        float cmin = min(sc.r, min(sc.g, sc.b));
        float sat = (cmax - cmin) / max(cmax, 1e-4);
        float energy = smoothstep(0.32, 0.90, luma) * (0.40 + 1.35 * sat);

        float w = depth_w * (1.0 - rad / max(max_rad, 1e-4) * 0.45);
        bounce_sum += sc * (energy * w);
        w_sum += w;
    }

    vec3 bounce = (w_sum > 1e-4) ? (bounce_sum / max(w_sum, 1.0)) : vec3(0.0);
    imageStore(u_ssgi_out, gid, vec4(bounce, 1.0));
}
