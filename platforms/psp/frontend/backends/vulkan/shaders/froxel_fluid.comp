#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Interactive World-Locked Ground-Fog Fluid Simulation (Adam Myhre semi-Lagrangian advection +
// Ocarina of Time Remake / OddPotatoDev dynamic actor parting wakes).
// Runs on a 128x128 RGBA16F world-snapped toroidal grid (24m x 24m around the player, ~0.02 ms!):
//   RG = horizontal fluid velocity (in world-grid texels/sec)
//   B  = mist density multiplier (1.0 = thick undisturbed ground mist, 0.05 = parted wake)
//   A  = displaced mist rim height boost (0..1, pushed-up swirling mist collar around wakes!)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D u_fluid_out;
layout(set = 0, binding = 1) uniform sampler2D u_fluid_prev;

struct FluidActor {
    vec4 pos_rad;  // x = world_x, y = foot_y, z = world_z, w = wake_radius (cm)
    vec4 vel_pad;  // x = vx (cm/s), y = vy, z = vz (cm/s), w = speed
};

struct FroxelFluidParams {
    vec4 grid_info;    // x = origin_x (cm), y = origin_z (cm), z = world_size (cm), w = dt (sec)
    vec4 shift_and_t;  // x = shift_texels_x, y = shift_texels_z, z = elapsed_sec, w = reset_flag
    uvec4 counts;      // x = actor_count (<=8), y = 0, z = 0, w = 0
    FluidActor actors[8];
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer FluidParamsBuf {
    FroxelFluidParams p;
};

layout(push_constant) uniform FluidPush {
    FluidParamsBuf buf;
} pc;

const float kGridN = 128.0;

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= int(kGridN) || gid.y >= int(kGridN)) return;

    FroxelFluidParams p = pc.buf.p;
    float dt = clamp(p.grid_info.w, 0.002, 0.05);
    float world_size = p.grid_info.z;
    float texel_cm = world_size / kGridN;

    vec2 uv = (vec2(gid) + 0.5) / kGridN;
    vec2 prev_uv_base = (vec2(gid) + 0.5 + p.shift_and_t.xy) / kGridN;

    vec4 state = vec4(0.0, 0.0, 1.0, 0.0);
    if (p.shift_and_t.w < 0.5 &&
        prev_uv_base.x > 0.008 && prev_uv_base.x < 0.992 &&
        prev_uv_base.y > 0.008 && prev_uv_base.y < 0.992) {
        // 1. Semi-Lagrangian velocity advection + gentle curl turbulence.
        vec4 s0 = texture(u_fluid_prev, prev_uv_base);
        vec2 vel = s0.rg;

        // Back-trace along fluid velocity (in texel units) + subtle ambient swamp breeze.
        vec2 breeze = vec2(0.45, 0.28);
        vec2 back_uv = prev_uv_base - (vel + breeze) * (dt / kGridN);
        vec4 adv = texture(u_fluid_prev, clamp(back_uv, vec2(0.004), vec2(0.996)));

        // Subtle 4-tap diffusion & vorticity swirl so wakes curl organically as they close.
        vec2 e = vec2(1.0 / kGridN, 0.0);
        vec4 sL = texture(u_fluid_prev, clamp(back_uv - e.xy, vec2(0.004), vec2(0.996)));
        vec4 sR = texture(u_fluid_prev, clamp(back_uv + e.xy, vec2(0.004), vec2(0.996)));
        vec4 sD = texture(u_fluid_prev, clamp(back_uv - e.yx, vec2(0.004), vec2(0.996)));
        vec4 sU = texture(u_fluid_prev, clamp(back_uv + e.yx, vec2(0.004), vec2(0.996)));
        vec4 blur = 0.25 * (sL + sR + sD + sU);
        float curl = (sR.g - sL.g) - (sU.r - sD.r);
        vec2 curl_force = vec2(sU.b - sD.b, sL.b - sR.b) * (curl * 0.35);

        state.rg = mix(adv.rg, blur.rg, 0.14) + curl_force * dt;
        state.b  = mix(adv.b,  blur.b,  0.10);
        state.a  = mix(adv.a,  blur.a,  0.16);

        // Brief, crisp organic recovery (~1.5s swirling trail behind hunter/monsters).
        state.rg *= exp(-dt * 2.8);
        state.b   = mix(state.b, 1.0, clamp(dt * 0.85, 0.0, 0.35));
        state.a  *= exp(-dt * 1.9);
    }

    // 2. Inject hunter & monster wakes ONLY when moving (brief, lively walk-through reaction!).
    vec2 cell_world_xz = p.grid_info.xy + uv * world_size;
    uint n_act = min(p.counts.x, 8u);
    for (uint i = 0u; i < n_act; ++i) {
        vec2 act_xz = p.actors[i].pos_rad.xz;
        float rad = max(p.actors[i].pos_rad.w, 70.0);
        vec2 d = cell_world_xz - act_xz;
        float dist = length(d);
        if (dist > rad * 2.5) continue;

        vec2 dir = (dist > 1.0) ? (d / dist) : vec2(1.0, 0.0);
        vec2 avel_tex = p.actors[i].vel_pad.xz / texel_cm;
        float speed = p.actors[i].vel_pad.w; // cm/s
        // Reacts briskly when walking/sprinting/rolling; gentle breath-sized opening when idle.
        float move_k = clamp(speed / 95.0, 0.0, 2.8);

        float inner = 1.0 - smoothstep(rad * 0.20, rad * 1.25, dist);
        float rim = smoothstep(rad * 0.85, rad * 1.45, dist) * (1.0 - smoothstep(rad * 1.45, rad * 2.45, dist));

        float part_strength = clamp(inner * (0.35 + 0.63 * clamp(move_k, 0.0, 1.0)), 0.0, 0.98);
        state.b = min(state.b, 1.0 - part_strength);
        state.a = clamp(state.a + rim * (0.55 * clamp(move_k, 0.0, 1.5)) * clamp(dt * 14.0, 0.20, 1.0), 0.0, 0.95);

        // Strong outward + perpendicular vortex swirl so you clearly see mist curl aside as you walk through!
        vec2 perp = vec2(-dir.y, dir.x);
        float side = sign(dot(perp, avel_tex) + 0.001);
        vec2 push_v = dir * (28.0 * move_k * (inner * 0.5 + rim))
                    + perp * (16.0 * side * move_k * rim)
                    + avel_tex * (0.65 * inner);
        state.rg = clamp(state.rg + push_v * clamp(dt * 12.0, 0.18, 1.0), vec2(-55.0), vec2(55.0));
    }

    // Softly fade border texels back to undisturbed mist so grid edges are 100% invisible.
    vec2 edge_d = min(uv, 1.0 - uv);
    float border = smoothstep(0.0, 0.06, min(edge_d.x, edge_d.y));
    state.rg *= border;
    state.b = mix(1.0, state.b, border);
    state.a *= border;

    imageStore(u_fluid_out, gid, state);
}
