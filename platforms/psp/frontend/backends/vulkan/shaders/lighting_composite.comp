#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Full-resolution unified Linear-HDR -> rich SDR lighting composite (runs after 3D, before 2D HUD):
// - Smooth bilateral upsampled GTAO + Contact Shadows + smooth view-space normals (zero cave polygon artifacts!)
// - Lock-free 2D screen-tile culling for up to 64 world-space dynamic point lights (MHFU-scale calibrated)
//   with highlight-preserving soft-add (no blown-out snow around campfires, vivid illumination in caves/night!)
// - Multi-bounce GTAO + world-up hemisphere bounce + gentle outdoor specular & Fresnel rim light
// - Quarter-res SSGI colored bounce + 4x2 dynamic emissive flash
// - Rayleigh/Mie atmospheric fog & volumetric sun shafts + HDR Karis bloom with heat shimmer
// - SDR-calibrated hue-preserving highlight shoulder + deep cave contrast + triangular IGN debanding

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1) uniform sampler u_samplers[];
layout(set = 1, binding = 0, rgba8) uniform image2D u_lit_out;
layout(set = 2, binding = 0) uniform sampler3D u_froxel_vol;
layout(set = 2, binding = 1) uniform sampler2D u_ground_fluid;

layout(constant_id = 0) const uint kSpecInPlace = 0u;

struct ViewPointLight {
    vec4 pos_radius;      // xyz = view-space pos (+Y down, -Z forward), w = radius
    vec4 color_intensity; // rgb = linear HDR color, w = intensity
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightListBuf {
    ViewPointLight items[];
};

struct LightingParams {
    vec4 proj_info;
    vec4 vz_and_size;
    vec4 sun_dir_view;  // xyz = sun dir in view space, w = is_cave
    vec4 sun_screen;    // xy = sun UV, z = sun_facing, w = frame_jitter
    vec4 shadow_tint;   // rgb = sky/biome shadow tint, a = ao_strength
    vec4 fog_color;     // rgb = fog color, a = fog_density
    vec4 scatter_color; // rgb = volumetric sun scatter color, a = scatter_strength
    vec4 bloom_rim;     // x = bloom_threshold, y = bloom_strength, z = rim_strength, w = key_strength
    vec4 world_up_view; // xyz = normalized world-up in view space, w = ssgi_strength
    vec4 ground_bounce; // rgb = biome ground/magma bounce tint, a = hemi_strength
    vec4 spec_contact;  // x = spec_strength, y = spec_gloss, z = contact_shadow_str, w = vibrance
    uvec4 tex_slots;    // x = color_slot, y = depth_slot, z = gtao_slot, w = vol_slot
    uvec4 aux_slots;    // x = bloom_slot, y = linear_sampler, z = out_w, w = out_h
    uvec4 ext_slots;    // x = ssgi_slot, y = gtao_raw_slot, z = biome_id, w = flags
    uvec4 phase1_slots; // x = gbuf_normal_slot, y = exposure_slot, z = hdr_flags, w = 0
    LightListBuf lights;
    uint light_count;
    uint lights_pad;
    mat4 shadow_from_view; // column-major: PSP view (+Y up) -> orthographic sun shadow clip space
    uvec4 shadow_info;     // x = shadow_map_slot, y = nearest_sampler, z = rt_shadow_slot, w = noise3d_slot
    mat4 inv_view;         // column-major: PSP view (+Y up) -> world space (cm)
    vec4 env_time;         // x = elapsed_sec, y = cam_world_y, z = vapor_strength, w = has_inv_view
    vec4 ground_fog_info;  // x = fluid_origin_x, y = ground_floor_y, z = fluid_origin_z, w = fluid_world_size
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightingParamsBuf {
    LightingParams p;
};

layout(push_constant) uniform LightingPush {
    LightingParamsBuf buf;
} pc;

shared uint s_tile_count;
shared uint s_tile_lights[32];

vec3 multi_bounce_ao(float ao, vec3 albedo) {
    vec3 a =  2.0404 * albedo - 0.3324;
    vec3 b = -4.7951 * albedo + 0.6417;
    vec3 c =  2.7552 * albedo + 0.6903;
    return max(vec3(ao), ((ao * a + b) * ao + c) * ao);
}

float ign(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float sample_vapor_noise(uint nslot, uint lsamp, vec3 uvw) {
    vec3 f = fract(uvw);
    float zf = f.z * 32.0;
    float z0 = floor(zf);
    float z1 = mod(z0 + 1.0, 32.0);
    float zt = fract(zf);
    vec2 tile0 = vec2(mod(z0, 8.0), floor(z0 / 8.0));
    vec2 tile1 = vec2(mod(z1, 8.0), floor(z1 / 8.0));
    vec2 local_uv = (f.xy * 30.0 + 1.0) / 32.0;
    vec2 uv0 = (tile0 + local_uv) / vec2(8.0, 4.0);
    vec2 uv1 = (tile1 + local_uv) / vec2(8.0, 4.0);
    float v0 = texture(sampler2D(u_textures[nslot], u_samplers[lsamp]), uv0).r;
    float v1 = texture(sampler2D(u_textures[nslot], u_samplers[lsamp]), uv1).r;
    return mix(v0, v1, zt);
}

vec3 srgb_to_linear_hdr(vec3 c) {
    vec3 a = max(c, vec3(0.0));
    return a * (a * (a * 0.305306011 + 0.682171111) + 0.012522878);
}

vec3 linear_to_srgb(vec3 c) {
    vec3 a = max(c, vec3(0.0));
    vec3 s1 = sqrt(a);
    vec3 s2 = sqrt(s1);
    vec3 s3 = sqrt(s2);
    return clamp(0.662002687 * s1 + 0.684122060 * s2 - 0.323583601 * s3 - 0.0225411470 * a, vec3(0.0), vec3(1.0));
}

float linear_eye_z(LightingParams p, float d) {
    float zn = (d * 65535.0 - p.vz_and_size.y) / max(abs(p.vz_and_size.x), 1e-3);
    float denom = zn + p.proj_info.z;
    if (abs(denom) < 1e-5) denom = (denom >= 0.0 ? 1e-5 : -1e-5);
    return clamp(abs(p.proj_info.w / denom), 0.1, 20000.0);
}

// SDR-calibrated hue-preserving highlight shoulder:
// Leaves [0 .. 0.80] linear rich and uncompressed; smoothly rolls off HDR fire/lightning above 0.80.
vec3 sdr_rich_tonemap(vec3 x) {
    vec3 a = max(x, vec3(0.0));
    float peak = max(a.r, max(a.g, a.b));
    if (peak <= 0.80) return a;
    float compressed = 0.80 + 0.20 * tanh((peak - 0.80) / 0.55);
    vec3 scaled = a * (compressed / peak);
    float hot = smoothstep(2.0, 4.8, peak) * 0.18;
    return mix(scaled, vec3(compressed), hot);
}

void main() {
    LightingParams p = pc.buf.p;
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = ivec2(p.vz_and_size.zw);
    bool in_bounds = (ip.x < sz.x && ip.y < sz.y);

    uint dslot = p.tex_slots.y;
    float d_here = in_bounds ? texelFetch(u_textures[dslot], ip, 0).r : 1.0;
    bool is_sky = (!in_bounds || d_here >= 0.99992 || d_here <= 0.00001);
    float z_eye = is_sky ? 0.0 : linear_eye_z(p, d_here);

    // 0. Lock-free 2D screen-tile culling for up to 64 world-space dynamic point lights.
    uint lid = gl_LocalInvocationIndex;
    if (p.light_count > 0u) {
        if (lid == 0u) s_tile_count = 0u;
        barrier();
        if (lid < p.light_count) {
            ViewPointLight pl = p.lights.items[lid];
            float r = pl.pos_radius.w;
            float neg_z = -pl.pos_radius.z;
            if (neg_z + r > 0.1) {
                vec2 tile_min_uv = vec2(gl_WorkGroupID.xy * 8u) / p.vz_and_size.zw;
                vec2 tile_max_uv = min(vec2((gl_WorkGroupID.xy + 1u) * 8u), p.vz_and_size.zw) / p.vz_and_size.zw;
                vec2 ndc_min = tile_min_uv * 2.0 - 1.0;
                vec2 ndc_max = tile_max_uv * 2.0 - 1.0;
                bool overlaps = true;
                if (neg_z > r + 0.5) {
                    float p00 = 1.0 / max(abs(p.proj_info.x), 1e-5);
                    float p11 = 1.0 / max(abs(p.proj_info.y), 1e-5);
                    vec2 c_ndc = vec2(pl.pos_radius.x * p00, pl.pos_radius.y * p11) / neg_z;
                    float z_near = max(neg_z - r, 0.5);
                    vec2 r_ndc = vec2(r * p00, r * p11) / z_near;
                    overlaps = (c_ndc.x + r_ndc.x >= ndc_min.x) && (c_ndc.x - r_ndc.x <= ndc_max.x) &&
                               (c_ndc.y + r_ndc.y >= ndc_min.y) && (c_ndc.y - r_ndc.y <= ndc_max.y);
                }
                if (overlaps) {
                    uint slot = atomicAdd(s_tile_count, 1u);
                    if (slot < 32u) s_tile_lights[slot] = lid;
                }
            }
        }
        barrier();
    }

    if (!in_bounds) return;

    vec4 scene = (kSpecInPlace != 0u) ? imageLoad(u_lit_out, ip) : texelFetch(u_textures[p.tex_slots.x], ip, 0);
    vec3 col_lin = srgb_to_linear_hdr(scene.rgb);
    vec3 albedo_est = clamp(col_lin, vec3(0.02), vec3(1.0));
    vec2 uv = (vec2(ip) + 0.5) / p.vz_and_size.zw;
    uint bid = p.ext_slots.z;
    bool is_cave = (p.sun_dir_view.w > 0.5);

    // 1. Depth-aware bilateral upsample of denoised half-res GTAO, Contact Shadows & smooth normal.
    if (!is_sky && p.tex_slots.z != 0u) {
        ivec2 gsize = textureSize(u_textures[p.tex_slots.z], 0);
        ivec2 gmax = gsize - ivec2(1);
        ivec2 full_max = sz - ivec2(1);
        vec2 gpos = vec2(ip) * 0.5 - 0.25;
        ivec2 base = ivec2(floor(gpos));
        vec2 f = clamp(gpos - vec2(base), 0.0, 1.0);

        float ao_sum = 0.0;
        float cs_sum = 0.0;
        vec2 nxy_sum = vec2(0.0);
        float w_sum = 0.0;
        for (int dy = 0; dy <= 1; ++dy) {
            for (int dx = 0; dx <= 1; ++dx) {
                ivec2 gc = clamp(base + ivec2(dx, dy), ivec2(0), gmax);
                ivec2 fc = clamp(gc * 2, ivec2(0), full_max);
                float ds = texelFetch(u_textures[dslot], fc, 0).r;
                float valid = (ds < 0.99992 && ds > 0.00001) ? 1.0 : 0.0;
                vec4 g = texelFetch(u_textures[p.tex_slots.z], gc, 0);
                float bw = (dx == 1 ? f.x : 1.0 - f.x) * (dy == 1 ? f.y : 1.0 - f.y);
                float dw = exp(-abs(ds - d_here) * 3500.0) * valid;
                float w = bw * dw + 1e-4;
                ao_sum += g.r * w;
                cs_sum += g.a * w;
                nxy_sum += (g.gb * 2.0 - 1.0) * w;
                w_sum += w;
            }
        }
        float ao = clamp(ao_sum / w_sum, 0.0, 1.0);
        float contact = clamp(cs_sum / w_sum, 0.0, 1.0);
        vec2 nxy = nxy_sum / w_sum;
        float nz = sqrt(max(1.0 - dot(nxy, nxy), 0.001));
        vec3 N = normalize(vec3(nxy, nz));

        vec2 ndc = uv * 2.0 - 1.0;
        vec3 P = vec3(ndc.x * p.proj_info.x * z_eye, ndc.y * p.proj_info.y * z_eye, -z_eye);
        vec3 V = normalize(-P);
        vec3 L = normalize(p.sun_dir_view.xyz);
        vec3 U = normalize(p.world_up_view.xyz);

        // Multi-bounce AO + Screen-Space Contact Shadows + Unified RT (Sun / Point-Light / RTAO) or Sun Shadow Map.
        float sun_shadow = 1.0;
        float pt_shadow = 1.0;
        if (p.shadow_info.z != 0u) {
            // Unified Hardware RT Lighting (VK_KHR_ray_query): 5x5 depth-aware bilateral upsample of half-res RGBA8:
            //   R = 4-spp soft sun shadow (outdoors), G = 2-spp dynamic point-light shadow (campfires/caves),
            //   B = 2-spp short-range 3D RTAO (halo-free grounding outdoors & in caves!).
            ivec2 rts = textureSize(u_textures[p.shadow_info.z], 0);
            ivec2 rtmax = rts - ivec2(1);
            ivec2 rbase = clamp(ip / 2, ivec2(0), rtmax);
            vec3 rt_sum = vec3(0.0);
            float rt_w = 0.0;
            for (int dy = -2; dy <= 2; ++dy) {
                for (int dx = -2; dx <= 2; ++dx) {
                    ivec2 rc = clamp(rbase + ivec2(dx, dy), ivec2(0), rtmax);
                    ivec2 fc = clamp(rc * 2, ivec2(0), full_max);
                    float ds = texelFetch(u_textures[dslot], fc, 0).r;
                    float dw = exp(-abs(ds - d_here) * 3200.0);
                    float sw = exp(-float(dx * dx + dy * dy) * 0.35);
                    float w = dw * sw + 1e-4;
                    rt_sum += texelFetch(u_textures[p.shadow_info.z], rc, 0).rgb * w;
                    rt_w += w;
                }
            }
            vec3 rt_val = clamp(rt_sum / rt_w, vec3(0.0), vec3(1.0));
            sun_shadow = is_cave ? 1.0 : rt_val.r;
            pt_shadow = mix(0.22, 1.0, rt_val.g);
            // Blend smooth distance-weighted 3D RTAO with GTAO for rock-solid, shimmer-free grounding everywhere!
            ao = mix(ao, mix(0.42, 1.0, rt_val.b), 0.34);
        } else if (!is_cave && p.shadow_info.x != 0u) {
            // Convert +Y-down view space back to PSP +Y-up view space with normal-offset bias.
            float sh_ndotl = clamp(dot(N, L), 0.0, 1.0);
            vec3 P_psp = vec3(P.x, -P.y, P.z) + vec3(N.x, -N.y, N.z) * 6.5;
            vec4 sc = p.shadow_from_view * vec4(P_psp, 1.0);
            vec2 suv = sc.xy * 0.5 + 0.5;
            if (suv.x > 0.01 && suv.x < 0.99 && suv.y > 0.01 && suv.y < 0.99 && sc.z > 0.0 && sc.z < 1.0) {
                float edge = max(abs(sc.x), abs(sc.y));
                float border_fade = 1.0 - smoothstep(0.82, 0.99, edge);
                float texel = 1.0 / 2048.0;
                float ang = ign(vec2(ip)) * 6.2831853;
                float ca = cos(ang), sa = sin(ang);
                const vec2 kPoisson4[4] = vec2[4](
                    vec2(-0.613,  0.342), vec2( 0.728,  0.221),
                    vec2(-0.241, -0.785), vec2( 0.412, -0.619)
                );
                float lit = 0.0;
                float bias = 0.0018 + (1.0 - sh_ndotl) * 0.0024;
                for (int s = 0; s < 4; ++s) {
                    vec2 d = kPoisson4[s];
                    vec2 rot = vec2(d.x * ca - d.y * sa, d.x * sa + d.y * ca) * (1.75 * texel);
                    float sd = texture(sampler2D(u_textures[p.shadow_info.x],
                                                 u_samplers[p.shadow_info.y]),
                                       suv + rot).r;
                    lit += (sc.z - bias <= sd) ? 1.0 : 0.0;
                }
                sun_shadow = mix(1.0, lit * 0.25, border_fade);
            }
        }
        vec3 shadow_tint_lin = srgb_to_linear_hdr(p.shadow_tint.rgb);
        float ao_shaped = is_cave ? pow(ao, 1.25) : ao;
        vec3 mb_ao = multi_bounce_ao(ao_shaped, albedo_est);
        vec3 tinted_ao = mix(shadow_tint_lin * (is_cave ? 0.60 : 0.90), vec3(1.0), mb_ao);
        vec3 tinted_cs = mix(shadow_tint_lin * 0.62, vec3(1.0), contact);
        vec3 tinted_sun_sh = mix(shadow_tint_lin * 0.54, vec3(1.0), sun_shadow);
        col_lin *= tinted_ao * tinted_cs * tinted_sun_sh;

        // 2. World-up Hemisphere Ambient Bounce (soft, never highlights individual flat polygons).
        if (p.ground_bounce.a > 0.001) {
            float up_dot = clamp(dot(N, U), -1.0, 1.0);
            float sky_w = max(up_dot, 0.0);
            float gnd_w = max(-up_dot, 0.0);
            vec3 ground_lin = srgb_to_linear_hdr(p.ground_bounce.rgb);
            vec3 hemi = shadow_tint_lin * (sky_w * (is_cave ? 0.22 : 0.38)) + ground_lin * (gnd_w * 0.80);
            col_lin += col_lin * hemi * (p.ground_bounce.a * (0.40 + 0.60 * ao));
        }

        // 3. Gentle outdoor sun key (no global fake specular/fresnel sheen on grass, dirt, rock, or wood!).
        float ndotl = clamp(dot(N, L), 0.0, 1.0);
        float sun_vis = ao * min(contact, sun_shadow);
        float key_boost = 1.0 + (ndotl - 0.35) * p.bloom_rim.w * sun_vis * (is_cave ? 0.45 : 1.0);
        col_lin *= clamp(key_boost, 0.88, 1.14);

        // 3b. World-space Tiled Dynamic Point Lights (highlight-preserving soft-add: never blows out bright snow,
        // while vividly lighting dark caves, night quests, torches, fireballs, and elemental combat hits!).
        if (p.light_count > 0u) {
            uint n_lights = min(s_tile_count, 32u);
            vec3 dyn_accum = vec3(0.0);
            for (uint i = 0u; i < n_lights; ++i) {
                ViewPointLight pl = p.lights.items[s_tile_lights[i]];
                vec3 to_l = pl.pos_radius.xyz - P;
                float dist2 = dot(to_l, to_l);
                float rad = pl.pos_radius.w;
                if (dist2 >= rad * rad || dist2 < 1e-4) continue;
                float dist = sqrt(dist2);
                vec3 ldir = to_l / dist;
                float dn = dist / rad;
                float t = clamp(1.0 - dn * dn, 0.0, 1.0);
                float att = (t * t) / (1.0 + dn * dn * 2.4);
                // Smooth omnidirectional wrap diffuse (avoids exposing flat low-poly cave triangles!).
                float wrap_ndotl = clamp((dot(N, ldir) + 0.45) / 1.45, 0.0, 1.0);
                vec3 light_rad = pl.color_intensity.rgb * (pl.color_intensity.w * att * (0.45 + 0.55 * ao));
                dyn_accum += light_rad * albedo_est * wrap_ndotl;
            }
            // Apply RT point-light shadow (real shadows from campfires, torches, fireballs & cave walls!)
            // and soft-compress stacked point lights so point-blank impacts never flood SDR.
            dyn_accum *= pt_shadow;
            dyn_accum = dyn_accum / (vec3(1.0) + dyn_accum * 0.85);
            vec3 headroom = clamp(vec3(1.0) - col_lin * 0.72, vec3(0.16), vec3(1.0));
            col_lin += dyn_accum * headroom;
        }

        // 4. Quarter-res SSGI-lite Colored Bounce (coarse 4x2 screen-space flash smear removed in favor of
        // true world-space dynamic point lights above).
        if (p.ext_slots.x != 0u && p.world_up_view.w > 0.001) {
            vec3 ssgi = srgb_to_linear_hdr(texture(sampler2D(u_textures[p.ext_slots.x],
                                                             u_samplers[p.aux_slots.y]),
                                                   uv).rgb);
            col_lin += ssgi * (0.30 + 0.70 * albedo_est) * (p.world_up_view.w * (0.45 + 0.55 * ao));
        }

        // 4b. Fast Water & Wet-Surface Screen-Space Reflections (reflects hunter, monsters, fireballs & trees!).
        // Restricted to truly flat horizontal water/puddle pixels in water-bearing biomes (early-outs on 85%+ of screen!).
        if (!is_cave && z_eye < 1100.0 && (bid == 11u || bid == 10u || bid == 8u || bid == 9u || bid == 6u)) {
            float flat_up = smoothstep(0.955, 0.992, dot(N, U));
            if (flat_up > 0.05) {
                vec3 cs = clamp(scene.rgb, vec3(0.0), vec3(1.0));
                float sluma = dot(cs, vec3(0.2126, 0.7152, 0.0722));
                float smax = max(cs.r, max(cs.g, cs.b));
                float smin = min(cs.r, min(cs.g, cs.b));
                float ssat = smax > 1e-4 ? (smax - smin) / smax : 0.0;
                float blue_ratio = cs.b / max(cs.r, 0.02);
                float wet_mask = 0.0;
                if (bid == 11u) {
                    // Swamp shallow water puddles: cool/neutral gray-blue sheen, excludes dry brown mud & foliage.
                    wet_mask = flat_up * smoothstep(0.11, 0.23, sluma) *
                               (1.0 - smoothstep(0.15, 0.30, ssat)) *
                               smoothstep(0.94, 1.04, blue_ratio);
                } else {
                    // Jungle, Forest & Hills, Great Forest, Desert oasis rivers/streams: cool blue/teal water.
                    wet_mask = flat_up * smoothstep(0.08, 0.20, sluma) *
                               smoothstep(1.04, 1.18, blue_ratio);
                }
                if (wet_mask > 0.08) {
                    // Subtle living water ripple normal perturbation.
                    float t_rip = p.sun_screen.w * 0.14;
                    vec3 N_rip = normalize(N + vec3(sin(uv.x * 160.0 + t_rip) * 0.014,
                                                    cos(uv.y * 120.0 - t_rip * 0.8) * 0.014, 0.0));
                    vec3 R = reflect(-V, N_rip);
                    // Only trace reflections heading upward/away from the water plane.
                    if (dot(R, U) > -0.05) {
                        float p00 = 1.0 / max(abs(p.proj_info.x), 1e-5);
                        float p11 = 1.0 / max(abs(p.proj_info.y), 1e-5);
                        float j = ign(vec2(ip));
                        float dist_t = 12.0 + j * 14.0;
                        float step_sz = 18.0;
                        vec3 hit_col = vec3(0.0);
                        float hit_w = 0.0;
                        for (int s = 0; s < 14; ++s) {
                            vec3 Q = P + R * dist_t;
                            float qz = -Q.z;
                            if (qz <= 2.0) break;
                            vec2 q_ndc = vec2(Q.x * p00, Q.y * p11) / qz;
                            vec2 q_uv = q_ndc * 0.5 + 0.5;
                            if (q_uv.x < 0.01 || q_uv.x > 0.99 || q_uv.y < 0.01 || q_uv.y > 0.99) break;
                            ivec2 qip = clamp(ivec2(q_uv * p.vz_and_size.zw), ivec2(0), full_max);
                            float qd = texelFetch(u_textures[dslot], qip, 0).r;
                            if (qd < 0.99992 && qd > 0.00001) {
                                float scene_z = linear_eye_z(p, qd);
                                float dz = qz - scene_z;
                                float thick = 16.0 + step_sz * 1.35;
                                if (dz > 2.0 && dz < thick && scene_z < z_eye + 40.0) {
                                    vec3 rcol = (kSpecInPlace != 0u)
                                                    ? imageLoad(u_lit_out, qip).rgb
                                                    : texelFetch(u_textures[p.tex_slots.x], qip, 0).rgb;
                                    hit_col = srgb_to_linear_hdr(rcol);
                                    float edge_fade = smoothstep(0.01, 0.10, q_uv.x) * smoothstep(0.99, 0.90, q_uv.x) *
                                                      smoothstep(0.01, 0.12, q_uv.y) * smoothstep(0.99, 0.88, q_uv.y);
                                    float dist_fade = 1.0 - smoothstep(260.0, 750.0, dist_t);
                                    hit_w = edge_fade * dist_fade;
                                    break;
                                }
                            }
                            dist_t += step_sz;
                            step_sz *= 1.18;
                        }
                        if (hit_w > 0.01) {
                            float ndotv = clamp(dot(N, V), 0.0, 1.0);
                            float fresnel = 0.10 + 0.42 * pow(1.0 - ndotv, 3.5);
                            float refl_str = clamp(wet_mask * hit_w * fresnel, 0.0, 0.48);
                            col_lin = mix(col_lin, hit_col, refl_str);
                        }
                    }
                }
            }
        }
    }

    // 5a. Ocarina-of-Time-Remake / Adam Myhre Full-Res Interactive Ground-Mist Blanket:
    //     Analytically intersects the ray with the world-locked ground mist slab [floor_y - 25, floor_y + 150 cm],
    //     marching 8 jittered steps ONLY inside the slab (early-outs in 1 instruction on sky/canopy!).
    //     Driven by the 128x128 semi-Lagrangian fluid sim (u_ground_fluid) so walking, rolling, and monster
    //     charges physically part & swirl the waist-high billowing mist around boots and tree trunks!
    if ((p.ext_slots.w & 32u) != 0u && p.env_time.w > 0.5 && p.ground_fog_info.w > 1.0 && p.env_time.z > 0.42) {
        vec2 ndc_g = uv * 2.0 - 1.0;
        vec3 ray_psp = normalize(vec3(ndc_g.x * p.proj_info.x, -ndc_g.y * p.proj_info.y, -1.0));
        vec3 cam_w = p.inv_view[3].xyz;
        vec3 ray_w = normalize(mat3(p.inv_view) * ray_psp);
        float max_t = is_sky ? 2100.0 : (z_eye / max(-ray_psp.z, 0.05));

        float floor_y = p.ground_fog_info.y;
        float y_bot = floor_y - 28.0;
        float y_top = floor_y + 152.0;

        float t_enter = 1e9;
        float t_exit = -1e9;
        if (abs(ray_w.y) > 1e-4) {
            float t0 = (y_bot - cam_w.y) / ray_w.y;
            float t1 = (y_top - cam_w.y) / ray_w.y;
            t_enter = min(t0, t1);
            t_exit  = max(t0, t1);
        } else if (cam_w.y >= y_bot && cam_w.y <= y_top) {
            t_enter = 35.0;
            t_exit  = max_t;
        }
        t_enter = max(t_enter, 35.0);
        t_exit  = min(t_exit, min(max_t, 1950.0));

        if (t_exit > t_enter + 4.0) {
            const int kSteps = 8;
            float dt = (t_exit - t_enter) / float(kSteps);
            float j = ign(vec2(ip) + vec2(p.sun_screen.w * 1.7, p.sun_screen.w * 2.9));
            float t_cur = t_enter + dt * j;

            vec2 orig_xz = p.ground_fog_info.xz;
            float inv_wsize = 1.0 / p.ground_fog_info.w;
            float t_wind = p.env_time.x * 0.022;
            float vstr = clamp((p.env_time.z - 0.35) * 0.95, 0.0, 1.45);
            vec3 fog_lin = srgb_to_linear_hdr(p.fog_color.rgb);
            vec3 scat_lin = srgb_to_linear_hdr(p.scatter_color.rgb);
            vec3 shadow_mist = fog_lin * 0.42;
            vec3 crest_mist  = fog_lin * 1.62 + vec3(0.08, 0.11, 0.14);

            // Sample RT god-ray visibility once per pixel to carve crisp light shafts across the rolling mist!
            float rt_sun = 1.0;
            if (p.shadow_info.z != 0u && !is_cave) {
                rt_sun = texture(sampler2D(u_textures[p.shadow_info.z], u_samplers[p.aux_slots.y]), uv).a;
            }
            float cos_sun = clamp(dot(ray_psp, vec3(p.sun_dir_view.x, -p.sun_dir_view.y, p.sun_dir_view.z)), -1.0, 1.0);
            float silver = pow(clamp(cos_sun * 0.5 + 0.5, 0.0, 1.0), 4.0) * (is_cave ? 0.0 : 0.45);

            vec3 g_scatter = vec3(0.0);
            float g_trans = 1.0;
            uint nslot = p.shadow_info.w;
            uint lsamp = p.aux_slots.y;

            for (int s = 0; s < kSteps; ++s) {
                vec3 Q = cam_w + ray_w * t_cur;

                // Sample world-locked 128x128 interactive fluid simulation (hunter + monster wakes!).
                vec2 fuv = (Q.xz - orig_xz) * inv_wsize;
                vec4 fl = vec4(0.0, 0.0, 1.0, 0.0);
                if (fuv.x > 0.005 && fuv.x < 0.995 && fuv.y > 0.005 && fuv.y < 0.995) {
                    vec2 edge = min(fuv, 1.0 - fuv);
                    float em = smoothstep(0.005, 0.06, min(edge.x, edge.y));
                    fl = mix(fl, texture(u_ground_fluid, fuv), em);
                }
                vec2 fvel = fl.rg;
                float wake_open = clamp(fl.b, 0.04, 1.0);
                float rim_boost = clamp(fl.a, 0.0, 1.2);

                // Warp world coordinates by fluid velocity so the mist billows physically curl around wakes!
                vec2 Q_xz = Q.xz - fvel * 2.6;
                float n1 = 0.5, n2 = 0.5;
                if (nslot != 0u) {
                    vec3 uvw1 = vec3(Q_xz.x * 0.00052 + t_wind * 0.45, (Q.y - floor_y) * 0.0018, Q_xz.y * 0.00052 + t_wind * 0.28);
                    vec3 uvw2 = vec3(Q_xz.x * 0.00145 - t_wind * 0.85, (Q.y - floor_y) * 0.0032 + t_wind * 0.12, Q_xz.y * 0.00145 + t_wind * 0.65);
                    n1 = sample_vapor_noise(nslot, lsamp, uvw1);
                    n2 = sample_vapor_noise(nslot, lsamp, uvw2);
                }
                // Sculpted rolling billowing pillows (Ocarina of Time Lost Woods style: thick mounds + clear troughs!).
                float billow = smoothstep(0.28, 0.80, n1 * 0.64 + n2 * 0.36);
                float top_y = floor_y + 24.0 + 106.0 * billow + rim_boost * 44.0;

                // Soft fluffy top surface + gentle bottom hug + depth intersection feathering around boots/trunks!
                float under_top = 1.0 - smoothstep(top_y - 38.0, top_y, Q.y);
                float above_bot = smoothstep(y_bot, floor_y + 6.0, Q.y);
                float surf_soft = smoothstep(0.0, 26.0, max_t - t_cur);
                float dist_fade = 1.0 - smoothstep(1250.0, 1950.0, t_cur);

                float local_d = under_top * above_bot * surf_soft * dist_fade * (0.28 + 0.72 * billow) * wake_open;
                // Push extra wispy density into the displaced wake collar so parted trails have bright curling rims!
                local_d += rim_boost * under_top * above_bot * surf_soft * 0.35;

                float sigma = local_d * 0.0052 * vstr;
                if (sigma > 1e-5) {
                    // Self-shadowed crest lighting: glowing moonlit/sunlit tops, deep moody mud-hugging bellies!
                    float h_frac = clamp((Q.y - floor_y) / max(top_y - floor_y, 20.0), 0.0, 1.0);
                    float lit_k = clamp(0.22 + 0.78 * h_frac * (0.55 + 0.45 * rt_sun) + rim_boost * 0.18, 0.0, 1.25);
                    vec3 mist_col = mix(shadow_mist, crest_mist, clamp(lit_k, 0.0, 1.0))
                                  + scat_lin * (silver * rt_sun * h_frac * p.scatter_color.a * 0.85);

                    float step_t = exp(-sigma * dt);
                    g_scatter += g_trans * mist_col * (1.0 - step_t);
                    g_trans *= step_t;
                    if (g_trans < 0.08) break;
                }
                t_cur += dt;
            }
            col_lin = col_lin * g_trans + g_scatter;
        }
    }

    // 5b. True 3D Frostbite/Wronski Froxel Volumetric Fog (single hardware trilinear lookup at exact pixel depth!),
    //     or fallback to quarter-res 2D volumetric fog when Froxel Fog is OFF.
    if ((p.ext_slots.w & 32u) != 0u) {
        float z_sample = is_sky ? 2200.0 : clamp(z_eye, 70.0, 2200.0);
        float fw = log(z_sample / 70.0) / log(2200.0 / 70.0);
        vec4 froxel = texture(u_froxel_vol, vec3(uv, clamp(fw, 0.0, 1.0)));
        col_lin = col_lin * froxel.a + froxel.rgb;
    } else if (p.tex_slots.w != 0u) {
        vec4 vol = texture(sampler2D(u_textures[p.tex_slots.w],
                                     u_samplers[p.aux_slots.y]),
                           uv);
        col_lin = col_lin * vol.a + srgb_to_linear_hdr(vol.rgb);
    }

    // 6. Selective HDR emissive bloom + subtle rising heat-shimmer on warm fire/lava halos.
    if (p.aux_slots.x != 0u && p.bloom_rim.y > 0.001) {
        vec3 bloom = texture(sampler2D(u_textures[p.aux_slots.x],
                                       u_samplers[p.aux_slots.y]),
                             uv).rgb;
        float warm_fire = clamp((bloom.r - bloom.b * 1.35) * 3.0, 0.0, 1.0);
        if (warm_fire > 0.05) {
            float phase = p.sun_screen.w * 0.22;
            vec2 heat_off = vec2(sin(uv.y * 55.0 + phase) * 0.0014,
                                 -abs(cos(uv.x * 42.0 - phase * 0.8)) * 0.0018) * warm_fire;
            vec3 bloom_haze = texture(sampler2D(u_textures[p.aux_slots.x],
                                                u_samplers[p.aux_slots.y]),
                                      clamp(uv + heat_off, vec2(0.001), vec2(0.999))).rgb;
            bloom = mix(bloom, bloom_haze, 0.55);
        }
        col_lin += srgb_to_linear_hdr(bloom) * (p.bloom_rim.y * 1.05);
    }

    // 7. Gentle SDR-safe Adaptive Eye Exposure.
    if (p.phase1_slots.y != 0u) {
        float exp_gain = texelFetch(u_textures[p.phase1_slots.y], ivec2(0, 0), 0).r;
        if (exp_gain > 0.7 && exp_gain < 1.5) {
            col_lin *= exp_gain;
        }
    }

    // 8. Rich SDR-calibrated hue-preserving highlight shoulder -> sRGB.
    vec3 col = linear_to_srgb(sdr_rich_tonemap(col_lin));

    // 9. Rich contrast & biome color vibrance on SDR.
    {
        float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
        float cmax = max(col.r, max(col.g, col.b));
        float cmin = min(col.r, min(col.g, col.b));
        float sat = cmax - cmin;
        float vib = (p.spec_contact.w + 0.05) * (1.0 - clamp(sat, 0.0, 1.0));
        col = mix(vec3(luma), col, 1.0 + vib);
        vec3 scurve = col * col * (3.0 - 2.0 * col);
        col = mix(col, scurve, is_cave ? 0.14 : 0.07);
    }

    // 10. Aspect-corrected, luminance-preserving cinematic vignette.
    if ((p.ext_slots.w & 2u) != 0u) {
        float vig_str = 0.0;
        vec3 vig_tint = vec3(1.0);
        if (bid == 3u) { vig_str = 0.12; vig_tint = vec3(0.84, 0.94, 1.06); }
        else if (bid == 4u) { vig_str = 0.09; vig_tint = vec3(1.05, 0.94, 0.84); }
        else if (bid == 5u) { vig_str = 0.16; vig_tint = vec3(0.88, 0.91, 1.00); }
        else if (bid == 11u) { vig_str = 0.10; vig_tint = vec3(0.88, 0.96, 1.02); }
        else if (bid == 12u) { vig_str = 0.10; vig_tint = vec3(1.08, 0.88, 0.78); }
        else if (bid == 14u) { vig_str = 0.10; vig_tint = vec3(0.92, 0.93, 0.98); }
        else { vig_str = 0.03; }
        if (vig_str > 0.0) {
            float aspect = p.vz_and_size.z / max(p.vz_and_size.w, 1.0);
            vec2 vc = (uv * 2.0 - 1.0) * vec2(aspect / 1.765, 1.0);
            float r2 = dot(vc, vc);
            float vig_mask = smoothstep(0.55, 1.75, r2) * vig_str;
            float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
            float hi_protect = 1.0 - smoothstep(0.75, 1.0, luma) * 0.5;
            col *= mix(vec3(1.0), vig_tint * (1.0 - vig_mask * hi_protect), clamp(vig_mask * 2.0, 0.0, 1.0));
        }
    }

    // 11. Triangular IGN debanding before RGBA8 store.
    float dither = (ign(vec2(ip)) + ign(vec2(ip) + vec2(17.0, 31.0)) - 1.0) / 255.0;
    col = clamp(col + vec3(dither), vec3(0.0), vec3(1.0));
    imageStore(u_lit_out, ip, vec4(col, scene.a));
}
