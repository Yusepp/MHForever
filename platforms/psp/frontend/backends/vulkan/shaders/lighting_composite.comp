#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Full-resolution unified lighting composite (runs once after 3D and before 2D HUD):
// - Depth-aware bilateral upsample of multi-bounce GTAO with biome/sky-tinted crevice shading
// - Subtle per-pixel sun key accent + Fresnel rim light (reconstructed normal, sky-masked)
// - Depth-aware bilateral upsample of volumetric fog & sun shafts
// - Selective emissive bloom + gentle filmic highlight shoulder

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1) uniform sampler u_samplers[];
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D u_lit_out;

struct LightingParams {
    vec4 proj_info;
    vec4 vz_and_size;
    vec4 sun_dir_view;  // xyz = sun dir in view space, w = is_cave
    vec4 sun_screen;    // xy = sun UV, z = sun_facing, w = frame_jitter
    vec4 shadow_tint;   // rgb = sky/biome shadow tint, a = ao_strength
    vec4 fog_color;     // rgb = fog color, a = fog_density
    vec4 scatter_color; // rgb = volumetric sun scatter color, a = scatter_strength
    vec4 bloom_rim;     // x = bloom_threshold, y = bloom_strength, z = rim_strength, w = key_strength
    vec4 world_up_view; // xyz = normalized world-up in view space, w = ssgi_strength
    vec4 ground_bounce; // rgb = biome ground/magma bounce tint, a = hemi_strength
    vec4 spec_contact;  // x = spec_strength, y = spec_gloss, z = contact_shadow_str, w = vibrance
    uvec4 tex_slots;    // x = color_slot, y = depth_slot, z = gtao_slot, w = vol_slot
    uvec4 aux_slots;    // x = bloom_slot, y = linear_sampler, z = out_w, w = out_h
    uvec4 ext_slots;    // x = ssgi_slot, y = gtao_raw_slot, z = biome_id, w = flags
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightingParamsBuf {
    LightingParams p;
};

layout(push_constant) uniform LightingPush {
    LightingParamsBuf buf;
} pc;

// Multi-bounce GTAO approximation (Jimenez et al.): preserves surface chroma inside crevices.
vec3 multi_bounce_ao(float ao, vec3 albedo) {
    vec3 a =  2.0404 * albedo - 0.3324;
    vec3 b = -4.7951 * albedo + 0.6417;
    vec3 c =  2.7552 * albedo + 0.6903;
    return max(vec3(ao), ((ao * a + b) * ao + c) * ao);
}

// Triangular IGN dither for 8-bit debanding (eliminates banding in fog, skies & dark cave ceilings).
float ign(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

// Gentle highlight-preserving filmic shoulder: exact identity below 0.85 so bright snow & midtones
// stay faithful to MHFU art, with C1-smooth asymptotic rolloff above 0.85 for HDR bloom/shafts.
vec3 soft_filmic(vec3 x) {
    vec3 a = max(x, vec3(0.0));
    vec3 hi = 0.85 + 0.15 * tanh((a - 0.85) / 0.15);
    return mix(a, hi, step(vec3(0.85), a));
}

void main() {
    LightingParams p = pc.buf.p;
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(p.vz_and_size.z) || ip.y >= int(p.vz_and_size.w)) return;

    vec4 scene = texelFetch(u_textures[nonuniformEXT(p.tex_slots.x)], ip, 0);
    vec3 col = scene.rgb;
    vec2 uv = (vec2(ip) + 0.5) / p.vz_and_size.zw;

    uint dslot = p.tex_slots.y;
    float d_here = texelFetch(u_textures[nonuniformEXT(dslot)], ip, 0).r;
    bool is_sky = (d_here >= 0.99992 || d_here <= 0.00001);

    // 1. Depth-aware bilateral upsample of denoised half-res GTAO, Contact Shadows & view-space normal.
    if (!is_sky && p.tex_slots.z != 0u) {
        ivec2 gsize = textureSize(u_textures[nonuniformEXT(p.tex_slots.z)], 0);
        ivec2 gmax = gsize - ivec2(1);
        ivec2 full_max = ivec2(p.vz_and_size.zw) - ivec2(1);
        vec2 gpos = vec2(ip) * 0.5 - 0.25;
        ivec2 base = ivec2(floor(gpos));
        vec2 f = clamp(gpos - vec2(base), 0.0, 1.0);

        float ao_sum = 0.0;
        float cs_sum = 0.0;
        vec2 nxy_sum = vec2(0.0);
        float w_sum = 0.0;
        for (int dy = 0; dy <= 1; ++dy) {
            for (int dx = 0; dx <= 1; ++dx) {
                ivec2 gc = clamp(base + ivec2(dx, dy), ivec2(0), gmax);
                ivec2 fc = clamp(gc * 2, ivec2(0), full_max);
                float ds = texelFetch(u_textures[nonuniformEXT(dslot)], fc, 0).r;
                float valid = (ds < 0.99992 && ds > 0.00001) ? 1.0 : 0.0;
                vec4 g = texelFetch(u_textures[nonuniformEXT(p.tex_slots.z)], gc, 0);
                float bw = (dx == 1 ? f.x : 1.0 - f.x) * (dy == 1 ? f.y : 1.0 - f.y);
                float dw = exp(-abs(ds - d_here) * 3500.0) * valid;
                float w = bw * dw + 1e-4;
                ao_sum += g.r * w;
                cs_sum += g.a * w;
                nxy_sum += (g.gb * 2.0 - 1.0) * w;
                w_sum += w;
            }
        }
        float ao = clamp(ao_sum / w_sum, 0.0, 1.0);
        float contact = clamp(cs_sum / w_sum, 0.0, 1.0);
        vec2 nxy = nxy_sum / w_sum;
        float nz = sqrt(max(1.0 - dot(nxy, nxy), 0.001));
        vec3 N = normalize(vec3(nxy, nz));

        vec2 ndc = uv * 2.0 - 1.0;
        vec3 V = normalize(vec3(-ndc.x * p.proj_info.x, -ndc.y * p.proj_info.y, 1.0));
        vec3 L = normalize(p.sun_dir_view.xyz);
        vec3 U = normalize(p.world_up_view.xyz);

        // Multi-bounce AO + Screen-Space Contact Shadows tinted by biome sky/shadow color.
        vec3 mb_ao = multi_bounce_ao(ao, col);
        vec3 tinted_ao = mix(p.shadow_tint.rgb, vec3(1.0), mb_ao);
        vec3 tinted_cs = mix(p.shadow_tint.rgb * 0.72, vec3(1.0), contact);
        col *= tinted_ao * tinted_cs;

        // 2. World-up Hemisphere Ambient Bounce (sky bounce upward, snow/sand/magma under-glow downward).
        if (p.ground_bounce.a > 0.001) {
            float up_dot = clamp(dot(N, U), -1.0, 1.0);
            float sky_w = max(up_dot, 0.0);
            float gnd_w = max(-up_dot, 0.0);
            vec3 hemi = p.shadow_tint.rgb * (sky_w * 0.45) + p.ground_bounce.rgb * gnd_w;
            col += col * hemi * (p.ground_bounce.a * (0.4 + 0.6 * ao));
        }

        // 3. Per-pixel sun key contrast + GGX-lite biome specular sheen + Fresnel rim light.
        float ndotl = clamp(dot(N, L), 0.0, 1.0);
        float sun_vis = ao * contact;
        float key_boost = 1.0 + (ndotl - 0.35) * p.bloom_rim.w * sun_vis;
        col *= clamp(key_boost, 0.88, 1.16);

        float ndotv = clamp(dot(N, V), 0.0, 1.0);
        float fresnel = pow(1.0 - ndotv, 3.0);
        if (p.spec_contact.x > 0.001 && p.sun_dir_view.w < 0.5) {
            vec3 H = normalize(L + V);
            float ndoth = clamp(dot(N, H), 0.0, 1.0);
            float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
            float spec = pow(ndoth, max(p.spec_contact.y, 4.0)) * (0.25 + 0.75 * fresnel) * ndotl;
            col += p.scatter_color.rgb * (spec * p.spec_contact.x * sun_vis * (0.35 + 0.65 * luma));
        }
        if (p.bloom_rim.z > 0.001) {
            float sun_align = clamp(dot(N, L) * 0.5 + 0.5, 0.0, 1.0);
            col += p.scatter_color.rgb * (fresnel * sun_align * p.bloom_rim.z * sun_vis);
        }

        // 4. Quarter-res SSGI-lite Colored Bounce + Coarse 4x2 Dynamic Emissive Flash (explosions/fireballs/lightning).
        if (p.ext_slots.x != 0u && p.world_up_view.w > 0.001) {
            vec3 ssgi = texture(sampler2D(u_textures[nonuniformEXT(p.ext_slots.x)],
                                          u_samplers[nonuniformEXT(p.aux_slots.y)]),
                                uv).rgb;
            col += ssgi * (0.35 + 0.65 * col) * (p.world_up_view.w * (0.45 + 0.55 * ao));
        }
        if (p.ext_slots.y != 0u) {
            vec3 flash = texture(sampler2D(u_textures[nonuniformEXT(p.ext_slots.y)],
                                           u_samplers[nonuniformEXT(p.aux_slots.y)]),
                                 uv).rgb;
            // Subtle room-wide colored illumination during bright explosions, fireballs & thunderbolts.
            col += flash * (0.25 + 0.75 * col) * (0.32 * (0.45 + 0.55 * ao));
        }
    }

    // 5. Smooth bilinear upsample of quarter-res volumetric fog & sun shafts.
    if (p.tex_slots.w != 0u) {
        vec4 vol = texture(sampler2D(u_textures[nonuniformEXT(p.tex_slots.w)],
                                     u_samplers[nonuniformEXT(p.aux_slots.y)]),
                           uv);
        col = col * vol.a + vol.rgb;
    }

    // 6. Selective emissive bloom + subtle rising heat-shimmer on warm fire/lava halos (100% race-free).
    if (p.aux_slots.x != 0u && p.bloom_rim.y > 0.001) {
        vec3 bloom = texture(sampler2D(u_textures[nonuniformEXT(p.aux_slots.x)],
                                       u_samplers[nonuniformEXT(p.aux_slots.y)]),
                             uv).rgb;
        float warm_fire = clamp((bloom.r - bloom.b * 1.35) * 3.0, 0.0, 1.0);
        if (warm_fire > 0.05) {
            float phase = p.sun_screen.w * 0.22;
            vec2 heat_off = vec2(sin(uv.y * 55.0 + phase) * 0.0014,
                                 -abs(cos(uv.x * 42.0 - phase * 0.8)) * 0.0018) * warm_fire;
            vec3 bloom_haze = texture(sampler2D(u_textures[nonuniformEXT(p.aux_slots.x)],
                                                u_samplers[nonuniformEXT(p.aux_slots.y)]),
                                      clamp(uv + heat_off, vec2(0.001), vec2(0.999))).rgb;
            bloom = mix(bloom, bloom_haze, 0.55);
        }
        col += bloom * p.bloom_rim.y;
    }

    // 7. Subtle biome color harmony (gentle vibrance boost on desaturated midtones, preserving highlights).
    if (p.spec_contact.w > 0.001) {
        float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
        float cmax = max(col.r, max(col.g, col.b));
        float cmin = min(col.r, min(col.g, col.b));
        float sat = cmax - cmin;
        float vib = p.spec_contact.w * (1.0 - clamp(sat, 0.0, 1.0));
        col = mix(vec3(luma), col, 1.0 + vib);
    }

    // 8. Subtle cinematic edge framing ONLY in moody biomes (Caves, CozyIndoor, Swamp, Volcano, Castle Schrade).
    uint bid = p.ext_slots.z;
    float vig_str = 0.0;
    if (bid == 3u || bid == 4u || bid == 5u) vig_str = 0.08;      // IceCave, CozyIndoor, DarkCave
    else if (bid == 11u || bid == 12u || bid == 14u) vig_str = 0.06; // Swamp, Volcano, FortressSiege
    if (vig_str > 0.0) {
        vec2 vc = uv * 2.0 - 1.0;
        float r2 = dot(vc, vc);
        float vig = 1.0 - smoothstep(0.65, 1.85, r2) * vig_str;
        col *= vig;
    }

    // 9. Gentle C1-smooth highlight rolloff + triangular IGN debanding before RGBA8 store.
    col = soft_filmic(col);
    float dither = (ign(vec2(ip)) + ign(vec2(ip) + vec2(17.0, 31.0)) - 1.0) / 255.0;
    col = clamp(col + vec3(dither), vec3(0.0), vec3(1.0));
    imageStore(u_lit_out, ip, vec4(col, scene.a));
}
