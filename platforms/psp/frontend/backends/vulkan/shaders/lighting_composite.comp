#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Full-resolution unified lighting composite (runs once after 3D and before 2D HUD):
// - Depth-aware bilateral upsample of multi-bounce GTAO with biome/sky-tinted crevice shading
// - Subtle per-pixel sun key accent + Fresnel rim light (reconstructed normal, sky-masked)
// - Depth-aware bilateral upsample of volumetric fog & sun shafts
// - Selective emissive bloom + gentle filmic highlight shoulder

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1) uniform sampler u_samplers[];
layout(set = 1, binding = 0, rgba8) uniform image2D u_scene_color;

struct LightingParams {
    vec4 proj_info;
    vec4 vz_and_size;
    vec4 sun_dir_view;  // xyz = sun dir in view space, w = is_cave
    vec4 sun_screen;    // xy = sun UV, z = sun_facing, w = frame_jitter
    vec4 shadow_tint;   // rgb = sky/biome shadow tint, a = ao_strength
    vec4 fog_color;     // rgb = fog color, a = fog_density
    vec4 scatter_color; // rgb = volumetric sun scatter color, a = scatter_strength
    vec4 bloom_rim;     // x = bloom_threshold, y = bloom_strength, z = rim_strength, w = key_strength
    uvec4 tex_slots;    // x = color_slot, y = depth_slot, z = gtao_slot, w = vol_slot
    uvec4 aux_slots;    // x = bloom_slot, y = linear_sampler, z = out_w, w = out_h
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightingParamsBuf {
    LightingParams p;
};

layout(push_constant) uniform LightingPush {
    LightingParamsBuf buf;
} pc;

// Multi-bounce GTAO approximation (Jimenez et al.): preserves surface chroma inside crevices.
vec3 multi_bounce_ao(float ao, vec3 albedo) {
    vec3 a =  2.0404 * albedo - 0.3324;
    vec3 b = -4.7951 * albedo + 0.6417;
    vec3 c =  2.7552 * albedo + 0.6903;
    return max(vec3(ao), ((ao * a + b) * ao + c) * ao);
}

// Gentle highlight-preserving filmic shoulder (keeps midtones/blacks faithful to MHFU art).
vec3 soft_filmic(vec3 x) {
    vec3 a = max(x, vec3(0.0));
    return (a * (1.0 + a * 0.22)) / (1.0 + a * 0.35);
}

void main() {
    LightingParams p = pc.buf.p;
    ivec2 ip = ivec2(gl_GlobalInvocationID.xy);
    if (ip.x >= int(p.vz_and_size.z) || ip.y >= int(p.vz_and_size.w)) return;

    vec4 scene = imageLoad(u_scene_color, ip);
    vec3 col = scene.rgb;
    vec2 uv = (vec2(ip) + 0.5) / p.vz_and_size.zw;

    uint dslot = p.tex_slots.y;
    float d_here = texelFetch(u_textures[nonuniformEXT(dslot)], ip, 0).r;
    bool is_sky = (d_here >= 0.99992 || d_here <= 0.00001);

    // 1. Depth-aware bilateral upsample of half-res GTAO + view-space normal.
    if (!is_sky && p.tex_slots.z != 0u) {
        ivec2 gsize = textureSize(u_textures[nonuniformEXT(p.tex_slots.z)], 0);
        ivec2 gmax = gsize - ivec2(1);
        ivec2 full_max = ivec2(p.vz_and_size.zw) - ivec2(1);
        vec2 gpos = vec2(ip) * 0.5 - 0.25;
        ivec2 base = ivec2(floor(gpos));
        vec2 f = clamp(gpos - vec2(base), 0.0, 1.0);

        float ao_sum = 0.0;
        vec2 nxy_sum = vec2(0.0);
        float w_sum = 0.0;
        for (int dy = 0; dy <= 1; ++dy) {
            for (int dx = 0; dx <= 1; ++dx) {
                ivec2 gc = clamp(base + ivec2(dx, dy), ivec2(0), gmax);
                ivec2 fc = clamp(gc * 2, ivec2(0), full_max);
                float ds = texelFetch(u_textures[nonuniformEXT(dslot)], fc, 0).r;
                vec4 g = texelFetch(u_textures[nonuniformEXT(p.tex_slots.z)], gc, 0);
                float bw = (dx == 1 ? f.x : 1.0 - f.x) * (dy == 1 ? f.y : 1.0 - f.y);
                float dw = exp(-abs(ds - d_here) * 3500.0) * g.a;
                float w = bw * dw + 1e-4;
                ao_sum += g.r * w;
                nxy_sum += (g.gb * 2.0 - 1.0) * w;
                w_sum += w;
            }
        }
        float ao = clamp(ao_sum / w_sum, 0.0, 1.0);
        vec2 nxy = nxy_sum / w_sum;
        float nz = sqrt(max(1.0 - dot(nxy, nxy), 0.001));
        vec3 N = normalize(vec3(nxy, nz));

        // Multi-bounce AO tinted slightly toward the biome's sky/ambient shadow color.
        vec3 mb_ao = multi_bounce_ao(ao, col);
        vec3 tinted_ao = mix(p.shadow_tint.rgb, vec3(1.0), mb_ao);
        col *= tinted_ao;

        // 2. Subtle per-pixel sun key contrast + Fresnel rim light (gives 3D volume to armor & monsters).
        vec3 L = normalize(p.sun_dir_view.xyz);
        float ndotl = clamp(dot(N, L), 0.0, 1.0);
        float key_boost = 1.0 + (ndotl - 0.35) * p.bloom_rim.w * ao;
        col *= clamp(key_boost, 0.88, 1.16);

        if (p.bloom_rim.z > 0.001) {
            vec2 ndc = uv * 2.0 - 1.0;
            vec3 V = normalize(vec3(-ndc.x * p.proj_info.x, -ndc.y * p.proj_info.y, 1.0));
            float fresnel = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 3.0);
            float sun_align = clamp(dot(N, L) * 0.5 + 0.5, 0.0, 1.0);
            col += p.scatter_color.rgb * (fresnel * sun_align * p.bloom_rim.z * ao);
        }
    }

    // 3. Smooth bilinear upsample of quarter-res volumetric fog & sun shafts.
    if (p.tex_slots.w != 0u) {
        vec4 vol = texture(sampler2D(u_textures[nonuniformEXT(p.tex_slots.w)],
                                     u_samplers[nonuniformEXT(p.aux_slots.y)]),
                           uv);
        col = col * vol.a + vol.rgb;
    }

    // 4. Selective emissive bloom (campfires, fireballs, lightning, magma, snow glare).
    if (p.aux_slots.x != 0u && p.bloom_rim.y > 0.001) {
        vec3 bloom = texture(sampler2D(u_textures[nonuniformEXT(p.aux_slots.x)],
                                       u_samplers[nonuniformEXT(p.aux_slots.y)]),
                             uv).rgb;
        col += bloom * p.bloom_rim.y;
    }

    // 5. Gentle highlight rolloff so bright embers/sun shafts stay rich without clipping.
    col = clamp(soft_filmic(col), vec3(0.0), vec3(1.0));
    imageStore(u_scene_color, ip, vec4(col, scene.a));
}
