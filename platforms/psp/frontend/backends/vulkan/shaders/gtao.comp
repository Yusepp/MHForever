#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

// Half-resolution Horizon-Based Multi-Bounce GTAO + smooth view-space normal reconstruction.
// Uses smallest-delta finite differences to prevent dark halos around hunter/monster silhouettes.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D u_gtao_out;

struct LightingParams {
    vec4 proj_info;     // x = 1/proj00, y = 1/proj11, z = proj10, w = proj14
    vec4 vz_and_size;   // x = vz_scale, y = vz_center, z = full_w, w = full_h
    vec4 sun_dir_view;  // xyz = normalized sun dir in view space, w = is_cave (0 or 1)
    vec4 sun_screen;    // xy = sun UV in [0,1], z = sun_facing [0,1], w = frame_jitter
    vec4 shadow_tint;   // rgb = sky/biome shadow tint, a = ao_strength
    vec4 fog_color;     // rgb = biome/PSP fog color, a = fog_density
    vec4 scatter_color; // rgb = volumetric sun scatter color, a = scatter_strength
    vec4 bloom_rim;     // x = bloom_threshold, y = bloom_strength, z = rim_strength, w = key_strength
    vec4 world_up_view; // xyz = normalized world-up in view space, w = ssgi_strength
    vec4 ground_bounce; // rgb = biome ground/magma bounce tint, a = hemi_strength
    vec4 spec_contact;  // x = spec_strength, y = spec_gloss, z = contact_shadow_str, w = vibrance
    uvec4 tex_slots;    // x = color_slot, y = depth_slot, z = gtao_slot, w = vol_slot
    uvec4 aux_slots;    // x = bloom_slot, y = linear_sampler, z = out_w, w = out_h
    uvec4 ext_slots;    // x = ssgi_slot, y = gtao_raw_slot, z = biome_id, w = flags
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightingParamsBuf {
    LightingParams p;
};

layout(push_constant) uniform LightingPush {
    LightingParamsBuf buf;
} pc;

float ign(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float linear_eye_z(LightingParams p, float d) {
    // Map normalized Vulkan depth [0,1] -> PSP depth [0,65535] -> NDC z -> positive eye distance.
    float zn = (d * 65535.0 - p.vz_and_size.y) / max(abs(p.vz_and_size.x), 1e-3);
    // Perspective: zn = A + B / (-z_eye) => z_eye = B / (zn - A), clamped safely.
    float denom = zn + p.proj_info.z;
    if (abs(denom) < 1e-5) denom = (denom >= 0.0 ? 1e-5 : -1e-5);
    return clamp(abs(p.proj_info.w / denom), 0.1, 20000.0);
}

vec3 view_pos_at(LightingParams p, ivec2 ip, float d) {
    float z = linear_eye_z(p, d);
    vec2 uv = (vec2(ip) + 0.5) / p.vz_and_size.zw;
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * p.proj_info.x * z, ndc.y * p.proj_info.y * z, -z);
}

void main() {
    LightingParams p = pc.buf.p;
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= int(p.aux_slots.z) || gid.y >= int(p.aux_slots.w)) return;

    ivec2 full_max = ivec2(p.vz_and_size.zw) - ivec2(1);
    ivec2 ip = clamp(gid * 2, ivec2(0), full_max);
    uint dslot = p.tex_slots.y;
    float d0 = texelFetch(u_textures[nonuniformEXT(dslot)], ip, 0).r;

    // Skybox / empty depth: full visibility, no AO.
    if (d0 >= 0.99992 || d0 <= 0.00001) {
        imageStore(u_gtao_out, gid, vec4(1.0, 0.5, 0.5, 0.0));
        return;
    }

    vec3 P = view_pos_at(p, ip, d0);
    float z0 = -P.z;

    // Discontinuity-aware normal reconstruction (avoids dark silhouette outlines).
    ivec2 ipL = clamp(ip - ivec2(2, 0), ivec2(0), full_max);
    ivec2 ipR = clamp(ip + ivec2(2, 0), ivec2(0), full_max);
    ivec2 ipU = clamp(ip - ivec2(0, 2), ivec2(0), full_max);
    ivec2 ipD = clamp(ip + ivec2(0, 2), ivec2(0), full_max);

    float dL = texelFetch(u_textures[nonuniformEXT(dslot)], ipL, 0).r;
    float dR = texelFetch(u_textures[nonuniformEXT(dslot)], ipR, 0).r;
    float dU = texelFetch(u_textures[nonuniformEXT(dslot)], ipU, 0).r;
    float dD = texelFetch(u_textures[nonuniformEXT(dslot)], ipD, 0).r;

    vec3 PL = view_pos_at(p, ipL, dL);
    vec3 PR = view_pos_at(p, ipR, dR);
    vec3 PU = view_pos_at(p, ipU, dU);
    vec3 PD = view_pos_at(p, ipD, dD);

    vec3 dPdx = (abs(PR.z - P.z) < abs(P.z - PL.z)) ? (PR - P) : (P - PL);
    vec3 dPdy = (abs(PD.z - P.z) < abs(P.z - PU.z)) ? (PD - P) : (P - PU);
    vec3 N = normalize(cross(dPdy, dPdx));
    if (dot(N, -P) < 0.0) N = -N;
    vec3 V = normalize(-P);

    // Horizon-based GTAO: 2 directions x 3 steps each side = 12 depth fetches (IGN-dithered).
    float noise = ign(vec2(gid) + p.sun_screen.w * 7.31);
    float base_angle = noise * 3.14159265;
    float radius_world = clamp(z0 * 0.065, 1.5, 42.0);
    float radius_px = clamp((radius_world / max(z0 * p.proj_info.x, 1e-3)) * (p.vz_and_size.z * 0.5), 4.0, 28.0);
    float inv_r2 = 1.0 / (radius_world * radius_world);

    float visibility = 0.0;
    const int kDirs = 2;
    const int kSteps = 3;

    for (int d_idx = 0; d_idx < kDirs; ++d_idx) {
        float ang = base_angle + float(d_idx) * (3.14159265 / float(kDirs));
        vec2 dir = vec2(cos(ang), sin(ang));
        float max_sin1 = 0.0;
        float max_sin2 = 0.0;

        for (int s = 1; s <= kSteps; ++s) {
            float frac = (float(s) - 0.35 * fract(noise * 13.7 + float(d_idx) * 0.5)) / float(kSteps);
            vec2 off = dir * (frac * radius_px);

            ivec2 q1 = clamp(ip + ivec2(off), ivec2(0), full_max);
            float ds1 = texelFetch(u_textures[nonuniformEXT(dslot)], q1, 0).r;
            if (ds1 < 0.99992) {
                vec3 S1 = view_pos_at(p, q1, ds1) - P;
                float len2 = dot(S1, S1);
                if (len2 > 1e-4) {
                    float falloff = clamp(1.0 - len2 * inv_r2, 0.0, 1.0);
                    float sin_h = dot(S1, N) * inversesqrt(len2);
                    max_sin1 = max(max_sin1, max(sin_h - 0.12, 0.0) * falloff);
                }
            }

            ivec2 q2 = clamp(ip - ivec2(off), ivec2(0), full_max);
            float ds2 = texelFetch(u_textures[nonuniformEXT(dslot)], q2, 0).r;
            if (ds2 < 0.99992) {
                vec3 S2 = view_pos_at(p, q2, ds2) - P;
                float len2 = dot(S2, S2);
                if (len2 > 1e-4) {
                    float falloff = clamp(1.0 - len2 * inv_r2, 0.0, 1.0);
                    float sin_h = dot(S2, N) * inversesqrt(len2);
                    max_sin2 = max(max_sin2, max(sin_h - 0.12, 0.0) * falloff);
                }
            }
        }

        // Normal-oriented horizon occlusion: zero self-occlusion on flat planes at any viewing angle,
        // crisp physically grounded contact shadows inside real crevices and corners.
        float occ = 0.5 * (max_sin1 + max_sin2);
        visibility += clamp(1.0 - occ * 1.15, 0.0, 1.0);
    }

    float ao = clamp(visibility / float(kDirs), 0.0, 1.0);
    ao = mix(1.0, pow(ao, 1.1), p.shadow_tint.a);
    imageStore(u_gtao_out, gid, vec4(ao, N.x * 0.5 + 0.5, N.y * 0.5 + 0.5, 1.0));
}
